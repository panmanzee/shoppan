# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build outputs ────────────────────────────────────────────
dist/
build/
.next/
out/
*.tsbuildinfo

# ── Environment / secrets (NEVER commit these) ───────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pino*.log

# ── OS / editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Prisma generated client (rebuilt from schema) ────────────
apps/api/node_modules/

# ── k6 test results ──────────────────────────────────────────
apps/api/k6/*.json
apps/api/k6/results/

