# Copy this file to .env and fill in real values. Never commit .env itself.

# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Database (matches docker-compose.yml service below)
# Host port is 5433, not 5432 — see the comment in docker-compose.yml.
DATABASE_URL="postgresql://kindred:kindred_dev_password@localhost:5433/kindred?schema=public"

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=kindred_session

# Stripe (Phase 3) — get from dashboard.stripe.com
# Leave blank in development to use the stub (no real charges).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# OpenAI (Phase 5) — get from platform.openai.com
# Leave blank to fall back to Postgres full-text search.
# After setting this, call POST /search/embeddings/backfill (ADMIN only)
# to populate vector embeddings for existing products.
OPENAI_API_KEY=sk-...
